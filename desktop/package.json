{
  "name": "agentbuddy-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tauri v2 desktop shell for AgentBuddy: connects to an agenthub server and opens the workbench.",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun run make-icon && tauri dev",
    "build": "bun run make-icon && tauri build",
    "icons": "tauri icon ./assets/app-icon.png",
    "make-icon": "bun scripts/make-icon.mjs",
    "stamp": "bun scripts/stamp.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:live": "node e2e/run.mjs --live"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@tauri-apps/plugin-notification": "2.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "vitest": "2.1.9"
  }
}
