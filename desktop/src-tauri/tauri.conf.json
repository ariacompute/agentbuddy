{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentbuddy",
  "version": "0.1.0",
  "identifier": "ai.ariacompute.agentbuddy.desktop",
  "build": {
    "frontendDist": "../frontend-stub"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "agentbuddy",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "title": "agentbuddy"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 Aria Compute",
    "category": "DeveloperTool",
    "shortDescription": "agentbuddy workbench",
    "longDescription": "Desktop shell for the agentbuddy unified agent workbench: connect it to an agenthub server and use the agents, threads, task tracing, approvals, channels, connectors and voice screens from your desktop.",
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/ariacompute/agentbuddy/releases/latest/download/latest.json",
        "https://gitee.com/ariacompute/agentbuddy/releases/latest/download/latest.json"
      ]
    }
  }
}
