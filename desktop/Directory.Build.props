<Project>
  <!-- Single source of truth for the product version: `ab-tool stamp <semver>` edits this file. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Authors>ariacompute</Authors>
    <Product>agentbuddy</Product>
    <Company>Aria Compute</Company>
    <Copyright>Copyright (c) 2026 Aria Compute</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
