<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AgentBuddy.App"
             x:Class="AgentBuddy.App.App"
             RequestedThemeVariant="Light">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://agentbuddy/Styles/Theme.axaml" />
    <StyleInclude Source="avares://agentbuddy/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
