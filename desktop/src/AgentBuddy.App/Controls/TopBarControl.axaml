<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AgentBuddy.App.Controls.TopBarControl">
  <DockPanel>
    <TextBlock Text="{Binding Title}" Classes="heading" VerticalAlignment="Center" />
    <TextBlock Text="{Binding VersionText}" Classes="muted" DockPanel.Dock="Right" VerticalAlignment="Center" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0" Spacing="4">
      <TextBlock Text="{Binding LanguageLabel}" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Lang}" MinWidth="110" />
      <Button Content="{Binding ThemeLabel}" Command="{Binding ToggleThemeCommand}" />
      <Button Content="{Binding NotificationsLabel}" Command="{Binding OpenNotificationCommand}" />
      <TextBlock Text="{Binding Unread}" VerticalAlignment="Center" />
    </StackPanel>
  </DockPanel>
</UserControl>
