<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AgentBuddy.App.Controls.PageHeaderControl">
  <StackPanel Spacing="8">
    <DockPanel>
      <Button Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}"
              DockPanel.Dock="Right" HorizontalAlignment="Right" />
      <TextBlock Text="{Binding Title}" Classes="heading" VerticalAlignment="Center" />
    </DockPanel>
    <TextBlock Text="{Binding ErrorText}" Classes="muted" />
    <ProgressBar IsIndeterminate="{Binding IsBusy}" MinHeight="4"
                 Foreground="{DynamicResource Brush.Text}" />
  </StackPanel>
</UserControl>
