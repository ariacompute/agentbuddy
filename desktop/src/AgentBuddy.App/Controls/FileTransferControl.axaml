<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AgentBuddy.App.Controls.FileTransferControl">
  <StackPanel Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="{Binding UploadLabel}" Command="{Binding UploadCommand}" />
      <Button Content="{Binding DownloadLabel}" Command="{Binding DownloadCommand}" />
      <Button Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
    </StackPanel>
    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" MinHeight="8"
                 Foreground="{DynamicResource Brush.Text}" />
  </StackPanel>
</UserControl>
