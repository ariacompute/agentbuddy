<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AgentBuddy.App.Controls.SidebarControl">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" Spacing="2">
      <Button Content="{Binding NavWorkspace}" Command="{Binding NavigateCommand}" CommandParameter="/" />
      <Button Content="{Binding NavThreads}" Command="{Binding NavigateCommand}" CommandParameter="/threads" />
      <Button Content="{Binding NavTasks}" Command="{Binding NavigateCommand}" CommandParameter="/tasks" />
      <Button Content="{Binding NavOrg}" Command="{Binding NavigateCommand}" CommandParameter="/org" />
      <Button Content="{Binding NavChannels}" Command="{Binding NavigateCommand}" CommandParameter="/channels" />
      <Button Content="{Binding NavConnectors}" Command="{Binding NavigateCommand}" CommandParameter="/connectors" />
      <Button Content="{Binding NavComputers}" Command="{Binding NavigateCommand}" CommandParameter="/computers" />
      <Button Content="{Binding NavSchedules}" Command="{Binding NavigateCommand}" CommandParameter="/schedules" />
      <Button Content="{Binding NavPersona}" Command="{Binding NavigateCommand}" CommandParameter="/persona" />
      <Button Content="{Binding NavKnowledge}" Command="{Binding NavigateCommand}" CommandParameter="/knowledge" />
      <Button Content="{Binding NavFiles}" Command="{Binding NavigateCommand}" CommandParameter="/files" />
      <Button Content="{Binding NavSettings}" Command="{Binding NavigateCommand}" CommandParameter="/settings" />
      <Button Content="{Binding LoginLabel}" Command="{Binding NavigateCommand}" CommandParameter="/login" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
