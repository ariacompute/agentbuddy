<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AgentBuddy.App.Controls"
             x:Class="AgentBuddy.App.Views.SettingsView">
  <StackPanel Margin="16" Spacing="8">
    <c:PageHeaderControl />
    <TextBlock Text="{Binding ExecutorLabel}" />
    <TextBlock Text="{Binding UpgradeLabel}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" />
      <Button Content="{Binding CheckLabel}" Command="{Binding CheckUpgradeCommand}" />
      <Button Content="{Binding InstallLabel}" Command="{Binding InstallUpgradeCommand}" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Items}" MinHeight="240" />
  </StackPanel>
</UserControl>
