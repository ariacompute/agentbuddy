<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AgentBuddy.App.Controls"
             x:Class="AgentBuddy.App.Views.TaskTraceView">
  <StackPanel Margin="16" Spacing="8">
    <c:PageHeaderControl />
    <c:TaskActionsControl />
    <ListBox ItemsSource="{Binding Items}" MinHeight="240" />
  </StackPanel>
</UserControl>
