<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AgentBuddy.App.Controls"
        x:Class="AgentBuddy.App.Views.MainWindow"
        Width="1280" Height="820" MinWidth="960" MinHeight="600"
        Title="agentbuddy" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panel">
      <c:TopBarControl />
    </Border>

    <Border DockPanel.Dock="Left" Width="230" Classes="panel" Padding="0">
      <c:SidebarControl />
    </Border>

    <ContentControl Content="{Binding CurrentView}" Margin="8" />
  </DockPanel>
</Window>
