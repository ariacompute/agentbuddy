<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AssemblyName>agentbuddy</AssemblyName>
    <RootNamespace>AgentBuddy.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**\*.png" />
    <AvaloniaResource Include="Assets\**\*.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentBuddy.Core\AgentBuddy.Core.csproj" />
    <ProjectReference Include="..\AgentBuddy.Shell\AgentBuddy.Shell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The composition root takes injected paths and the tray menu dispatch is internal,
         so the headless suite can drive them without touching the user profile. -->
    <InternalsVisibleTo Include="AgentBuddy.App.Tests" />
  </ItemGroup>
</Project>
