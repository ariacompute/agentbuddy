  "cards": [
    {
      "dot": "cyan",
      "title": "Streaming contract",
      "items": [
        "message/stream pushes status and artifact frames over SSE; there is no [DONE] sentinel",
        "Termination is expressed by completed / failed / canceled / input-required state events",
        "After a disconnect, GET /api/tasks/{id}/events?since=<seq> replays events before the live stream rejoins"
      ]
    },
    {
      "dot": "amber",
      "title": "HITL park and resume",
      "items": [
        "input-required can stay parked indefinitely; the question is persisted with the task in task_pending",
        "Resume by taskId via tasks/resume; resuming a task that is not parked returns task_not_resumable",
        "A human message takes precedence over the router's assessment"
      ]
    },
    {
      "dot": "slate",
      "title": "Loopback communication",
      "items": [
        "The workbench uses HttpClient to talk only to the loopback gateway on 127.0.0.1",
        "The session lives in an HttpOnly cookie that the gateway reuses",
        "Task bodies, artifacts, spans and event frames are persisted synchronously or best-effort"
      ]
    }
  ]
}
