  "activations": [
    { "participant": "workbench", "from": 155, "to": 620, "type": "frontend" },
    { "participant": "proxy", "from": 190, "to": 480, "type": "security" },
    { "participant": "a2a", "from": 225, "to": 515, "type": "backend" },
    { "participant": "hub", "from": 260, "to": 550, "type": "backend" },
    { "participant": "broker", "from": 295, "to": 585, "type": "messagebus" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "流式契约",
      "items": [
        "message/stream 以 SSE 推送状态与 artifact 帧，没有 [DONE] 哨兵",
        "终止由 completed / failed / canceled / input-required 状态事件表达",
        "断线后可用 GET /api/tasks/{id}/events?since=<seq> 回放再接实时流"
      ]
    },
    {
      "dot": "amber",
      "title": "HITL 挂起与恢复",
      "items": [
        "input-required 可无限期挂起，提问随任务落 task_pending",
        "凭 taskId 经 tasks/resume 续接；未挂起任务恢复返回 task_not_resumable",
        "人工消息优先于调度器的评估结论"
      ]
    },
    {
      "dot": "slate",
      "title": "本机通信",
      "items": [
        "工作台用 HttpClient 只与 127.0.0.1 上的环回网关通信",
        "会话保存在 HttpOnly Cookie 中，由代理复用",
        "任务主体、artifact、span 与事件帧同步或尽力而为地落库"
      ]
    }
  ]
