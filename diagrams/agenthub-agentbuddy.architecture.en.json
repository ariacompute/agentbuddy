  "cards": [
    {
      "dot": "slate",
      "title": "Division of labor",
      "items": [
        "AgentBuddy is a native .NET 10 / Avalonia client with no backend, no database and no WebView",
        "AgentHub is a single Go binary; resources, tasks, spans, events and callbacks all persist to PostgreSQL",
        "New server-side /api/* endpoints require no desktop client changes",
        "Only the sandbox and router streams stay open; thread and task streams follow navigation, and a template path is never subscribed"
      ]
    },
    {
      "dot": "violet",
      "title": "Admission and security boundary",
      "items": [
        "The loopback gateway forwards only /api, /a2a, /healthz and /.well-known",
        "A one-time nonce exchanges for an HttpOnly ab_proxy cookie; a mismatched Origin is refused before authentication",
        "No HTML is served, so no CSP nonce is needed; the session cookie is kept in the OS keychain",
        "The BYOM executor is optional and off by default; the Avalonia view has no command-execution permission"
      ]
    },
    {
      "dot": "cyan",
      "title": "External protocol",
      "items": [
        "Any A2A-compliant agent can discover and call via GET /.well-known/agent.json",
        "POST /a2a serves message/send, message/stream, tasks/get, tasks/cancel and tasks/resume",
        "The desktop workbench is not a required path for external agents"
      ]
    }
  ]
}
